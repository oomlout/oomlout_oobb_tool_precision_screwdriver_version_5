# Auto detect text files and perform LF normalization
* text=auto

# Preserve exact CAD and image bytes used by validation hashes.
/parts/** -text whitespace=cr-at-eol
/navigation_oobb/** text eol=lf
*.png -text
*.stl -text
/assembly/*.pdf binary
/assembly/assembly_instructions.html text eol=lf
/source_file/oomlout_logo_unshaded_original.svg -text

# Keep provenance hashes stable across fresh clones and platforms.
*.py -text
*.scad -text
*.json -text
*.yaml -text
/examples/** -text

*.py whitespace=cr-at-eol
*.scad whitespace=cr-at-eol
*.json whitespace=cr-at-eol
*.yaml whitespace=cr-at-eol
/examples/** whitespace=cr-at-eol

# Retained reference assets/templates preserve their original formatting.
/archive/v1-v2/old_version/** -text -whitespace
/source_file/** -whitespace
/data/** -whitespace
*.md whitespace=cr-at-eol,-blank-at-eol


# Preserve retired production parts and sources exactly.
/archive/v1-v2/parts/** -text -whitespace
/archive/v1-v2/parts_source/** -text -whitespace
