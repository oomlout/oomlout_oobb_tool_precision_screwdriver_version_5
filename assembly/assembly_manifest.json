  "steps": [
    {
      "title": "Slide in the driver bit",
      "action": "Feed the bit tip-first through the open bearing end. Slide it in until the hex shank seats and the tip projects from the nose.",
      "add": [
        "body",
        "bit"
      ],
      "move": {
        "bit": [
          0,
          0,
          112
        ]
      },
      "key": "step_01",
      "loose_parts": {
        "body": 1,
        "bit": 1
      }
    },
    {
      "title": "Lock the bit",
      "action": "Slide the lock key in behind the bit. Align its slot with the side hole, fit the side nut and tighten the M3 \u00d7 6 mm countersunk screw.",
      "add": [
        "key",
        "side_screw",
        "side_nut"
      ],
      "move": {
        "key": [
          0,
          0,
          45
        ],
        "side_screw": [
          10,
          0,
          0
        ],
        "side_nut": [
          -10,
          0,
          0
        ]
      },
      "key": "step_02",
      "loose_parts": {
        "key": 1,
        "side_screw": 1,
        "side_nut": 1
      }
    },
    {
      "title": "Load the cradle",
      "detail_from_z": 75,
      "action": "Slide the second M3 nut edge-first into the cradle, thread facing up. Push the cradle into the side slot until its curved face is flush.",
      "add": [
        "cradle",
        "top_nut"
      ],
      "move": {
        "cradle": [
          0,
          13,
          0
        ],
        "top_nut": [
          0,
          9,
          -0.65
        ]
      },
      "key": "step_03",
      "loose_parts": {
        "cradle": 1,
        "top_nut": 1
      }
    },
    {
      "title": "Seat the bearing",
      "detail_from_z": 75,
      "action": "Seat the lifter in the handle. Place the 606 on its raised centre, then fit the insert into the bearing bore, countersink facing up.",
      "add": [
        "lifter",
        "bearing",
        "insert"
      ],
      "move": {
        "lifter": [
          0,
          0,
          5
        ],
        "bearing": [
          0,
          0,
          13
        ],
        "insert": [
          0,
          0,
          24
        ]
      },
      "key": "step_04",
      "loose_parts": {
        "lifter": 1,
        "bearing": 1,
        "insert": 1
      }
    },
    {
      "title": "Fit the cap",
      "detail_from_z": 75,
      "action": "Tighten the M3 \u00d7 16 mm screw into the captive nut. Check the outer ring spins, press the cap onto it, and spin again under light pressure.",
      "add": [
        "top_screw",
        "cap"
      ],
      "move": {
        "top_screw": [
          0,
          0,
          8
        ],
        "cap": [
          0,
          0,
          23
        ]
      },
      "key": "step_05",
      "loose_parts": {
        "top_screw": 1,
        "cap": 1
      }
    }
  ],
